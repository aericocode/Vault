# Local env overrides (may hold endpoints/paths — never commit). .env.example
# is the committed, secret-free template.
/.env

# Per-install runtime state (scan-wizard history holds real local paths)
/wizard-settings.json
# ffmpeg fetched by the setup banner's download button lands next to the app
# (lib/ffmpeg-locate.js) — never ships in the repo or the release zip (GPL).
/ffmpeg.exe
/ffprobe.exe

# Per-install preferences written by the Settings modal. gamify-config.json was
# tracked by accident, which shipped the Obsession tracker switched ON to every
# clone — the opposite of the opt-in default the code documents.
/gamify-config.json
/vault-settings.json

__pycache__/

# License signing (private key NEVER ships; license.json is per-install)
/keys
/license.json

tools/sea/spike/dist/
/dist
WORKORDER-import-fixes.md

# Internal design docs — reference features that no longer exist. Not public.
/old specs/

# Runtime state the app writes INTO the repo root (config/index.js:161-172).
# None of it exists in a clean checkout, which is exactly the trap: it
# materializes the first time the app runs. trash/ receives the actual media
# files you delete from the library, so a stray `git add -A` after deleting
# one item would stage real content.
/trash/
/imports/
/sorted_media/
/secure_assets.db
/bad_json_responses.log
video_metadata.db-wal
video_metadata.db-shm

# Agent worktrees + local tool state. Until now this was only covered by
# .git/info/exclude, which is repo-local and would NOT survive publishing by
# copying the tree into a fresh directory.
/.claude/
