# ============================================================================
#  Video-Tagger / Vault — environment overrides
# ============================================================================
#
#  Copy this file to `.env` and uncomment the lines you want to change.
#
#  Every value below is OPTIONAL. config/index.js ships sensible defaults;
#  these variables only override them. The default is shown after each `=`.
#  Precedence:  shell environment  >  .env file  >  config default.
#  (dotenv never overrides a var already set in your real shell environment.)
#
#  Booleans: the code checks for the literal string 'true'/'false' or '0'.
#  Read each comment — the sense differs (some default ON, some OFF).
#
#  DO NOT put the Vault passphrase here — see the Security section below.
# ============================================================================


# ── AI backend (OpenAI-compatible /v1/chat/completions) ─────────────────────
# Comma-separate multiple endpoints to load-balance across GPUs/machines.
#   LM Studio: http://localhost:1234/v1/chat/completions  (default)
#   Ollama:    http://localhost:11434/v1/chat/completions (also set AI_MODEL)
# LM_STUDIO_URLS=http://localhost:1234/v1/chat/completions
# Model name sent with each request. LM Studio ignores it; Ollama/vLLM REQUIRE
# it, and scans need a VISION model (e.g. qwen2.5vl:7b).
# AI_MODEL=


# ── Transcription budget ────────────────────────────────────────────────────
# Max characters collected per scan-snippet transcription.
# WHISPER_MAX_CHARS=8000


# ── Whisper / subtitles (see SUBTITLES_SPEC.md) ─────────────────────────────
# Whisper model. large-v3-turbo = near-large accuracy at ~8x speed.
# Set to 'small' for low-VRAM hardware.
# WHISPER_MODEL=large-v3-turbo
# CTranslate2 compute type. Auto-downgrades to int8 on CPU.
# WHISPER_COMPUTE=int8_float16
# Device for the whisper sidecar: auto | cuda | cpu.
# WHISPER_DEVICE=auto

# Translation engine: 'opus' (local OPUS-MT via CTranslate2, auto-fetched per
# language pair) with LM Studio as the built-in fallback. 'llm' forces LM Studio.
# SUB_TRANSLATE=opus
# Generate subtitles automatically during a scan (true to enable).
# SUB_ON_SCAN=false
# Translate foreign audio to English during scan subtitle generation.
# Set to 'false' to keep original-language only.
# SUB_TRANSLATE_ON_SCAN=true

# Keep the loaded whisper/translation/diarization sidecars warm in the viewer.
# 0 = never unload once loaded; N = unload after N idle minutes (low-VRAM boxes).
# CLI scans always clean up at exit regardless.
# WHISPER_IDLE_MINUTES=5

# Voice-activity filter: decode only speech regions (skips music/silence).
# Big speedup on padded content, fewer hallucinations. WHISPER_VAD=0 disables.
# WHISPER_VAD=1
# Minimum silence (ms) that splits speech regions for the VAD.
# WHISPER_VAD_MIN_SILENCE_MS=500

# Network policy for AI MODELS (whisper + OPUS-MT + speaker-diarization models).
# Installed models ALWAYS load offline. This governs the ONE-TIME fetch of a
# not-yet-installed model:
#   1 (default) allow the one-time download; 0 never touch the network.
# SUB_ALLOW_DOWNLOADS=1

# Hard offline switch. 1 = no non-local network requests at all (model downloads,
# update checks, remote AI endpoints); localhost services keep working. Implies
# SUB_ALLOW_DOWNLOADS=0.
# VAULT_OFFLINE=1
# Where converted OPUS-MT translation models live (one dir per language pair).
# OPUS_MODEL_DIR=./models/opus-mt

# ── Speaker diarization (<v Speaker N> cue tags) ────────────────────────────
# Set 'false' to disable speaker labeling entirely.
# SUB_DIARIZE=true
# Backend: 'sherpa' (CPU, no HF account) or 'pyannote' (needs pyannote.audio + HF token).
# SUB_DIARIZE_BACKEND=sherpa
# DIARIZE_MODEL_DIR=./models/diarize
# Fixed speaker count. -1 = auto-detect.
# SUB_DIARIZE_SPEAKERS=-1
# Clustering threshold; higher -> fewer speakers. 0 = max-split (testing).
# SUB_DIARIZE_THRESHOLD=0.9

# Python interpreter used to launch the sidecars (whisper / OPUS-MT).
# PYTHON_PATH=python

# Per-file subtitle diagnostics (whisper pre-scan timing, "no speech detected"
# notices). Off by default — the server console only carries true errors.
# Turn on when chasing a model-loading or language-detection issue.
# SUBTITLES_DEBUG=1


# ── Performance ─────────────────────────────────────────────────────────────
# Parallel frame extraction workers (CPU-bound).
# FRAME_WORKERS=4
# Parallel vision API calls PER endpoint (GPU-bound). Total = endpoints * this.
# VISION_WORKERS=1
# Skip near-identical frames. Set 'false' to keep all.
# DEDUPE_FRAMES=true
# File queue batch size.
# BATCH_SIZE=50
# Pipeline depth per endpoint (files worked ahead to keep the GPU busy).
# Total workers = endpoints * VISION_WORKERS * this.
# PIPELINE_DEPTH=2
# Parallel scans in the in-app import queue (drag-drop / native pickers), 1-8.
# Separate from the CLI scan's --workers; adjustable live from the viewer.
# IMPORT_WORKERS=2


# ── Paths ───────────────────────────────────────────────────────────────────
# VIDEO_TAGGER_OUTPUT=./sorted_media
# VIDEO_TAGGER_DEBUG_LOG=./bad_json_responses.log
# VIDEO_TAGGER_TRASH=./trash
# (No import folder: Vault references media in place and never copies files.)


# ── Advanced / development only ─────────────────────────────────────────────
#
# ⚠ These override where Vault keeps its MANAGED cache/temp/database directories.
#   Vault CREATES and SWEEPS these folders: on startup and shutdown it wipes the
#   temp dirs, and in vault mode it deletes plaintext cache files. To protect
#   your data it only ever sweeps a directory that carries a ".vault-owned"
#   marker file it wrote itself (or adopts a pre-existing dir ONLY when it is
#   empty or contains nothing but Vault cache files).
#
#   POINTING ANY OF THESE AT A FOLDER THAT HOLDS YOUR OWN FILES IS UNSUPPORTED.
#   If Vault finds unrecognized files it will refuse to clean that folder and log
#   a warning — it will not delete your data, but the folder is not a safe place
#   for personal files. Use dedicated, Vault-only folders (the defaults are fine).
#
# VIDEO_TAGGER_TEMP=./temp_frames
# VIDEO_TAGGER_TEMP_AUDIO=./temp_audio
# VIDEO_TAGGER_THUMBS=./thumbnails
# VIDEO_TAGGER_SECURE_ASSETS=./secure_assets.db
# VIDEO_TAGGER_DB=./video_metadata.db


# ── Security (Vault lock — DB encryption) ───────────────────────────────────
#
# The Vault passphrase is INTENTIONALLY not configurable here. It is the
# AES-256/ChaCha20 key for the entire metadata DB and must NEVER be stored in a
# plaintext file. Set it on first launch through the viewer's lock screen; Vault boots
# in a locked state and prompts for a passphrase. (If VIDEO_TAGGER_DB_PASSWORD is found in
# .env it is dropped with a warning — see lib/load-env.js.)
#
# Auto-lock after N minutes without API activity (an active scan counts as
# activity). 0 = off.
# VAULT_AUTOLOCK_MINUTES=30


# ── Viewer server (local-only) ──────────────────────────────────────────────
# MEDIA_TAGGER_PORT=8765


# ── Thumbnails ──────────────────────────────────────────────────────────────
# THUMB_WIDTH=320


# ── Embeddings (semantic search over existing text metadata) ────────────────
# Set 'false' to disable.
# EMBEDDINGS=true
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBED_BATCH=32


# ── Duplicate detection ─────────────────────────────────────────────────────
# Set 'false' to disable scan-time dupe skipping.
# DUPE_SKIP=true
# Minimum file size (MB) to consider for dupe matching.
# DUPE_MIN_MB=10
# Size tolerance: files within +/- this fraction count as the same (0.01 = 1%).
# DUPE_SIZE_TOLERANCE=0.01
